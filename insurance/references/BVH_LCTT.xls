            <table><thead><tr><th>Lưu chuyển tiền từ HĐ kinh doanh</th><th></th><th>Q3-2025</th><th>Q4-2025</th><th>Q1-2026</th><th>Q2-2026</th><th></th></tr></thead><tbody><tr><td>1.Lợi nhuận trước thuế</td><td></td><td>2,664.79</td><td>3,715.17</td><td>1,005.99</td><td>2,289.36</td><td></td><td></td></tr><tr><td>2. Điều chỉnh cho các khoản:</td><td></td><td>-</td><td>-</td><td>-</td><td>-</td><td></td><td></td></tr><tr><td>Khấu hao tài sản cố định</td><td></td><td>180.83</td><td>239.03</td><td>58.27</td><td>115.93</td><td></td><td></td></tr><tr><td>Các khoản dự phòng</td><td></td><td>10,827.10</td><td>14,608.64</td><td>3,773.60</td><td>6,085.58</td><td></td><td></td></tr><tr><td>Lãi chênh lệch tỷ giá hối đoái do đánh giá lại các khoản mục tiền tệ có gốc ngoại tệ</td><td></td><td>13.57</td><td>13.26</td><td>0.82</td><td>2.82</td><td></td><td></td></tr><tr><td>Lãi từ hoạt động đầu tư</td><td></td><td>-10,306.83</td><td>-14,125.67</td><td>-4,016.23</td><td>-8,472.94</td><td></td><td></td></tr><tr><td>Chi phí lãi vay</td><td></td><td>1,210.64</td><td>1,741.98</td><td>755.67</td><td>1,654.13</td><td></td><td></td></tr><tr><td>Các khoản điều chỉnh khác</td><td></td><td>-</td><td>-1.05</td><td>-</td><td>-</td><td></td><td></td></tr><tr><td>3.Lợi nhuận từ hoạt động kinh doanh trước thay đổi vốn lưu động</td><td></td><td>4,590.10</td><td>6,191.36</td><td>1,578.13</td><td>1,674.87</td><td></td><td></td></tr><tr><td>Tăng các khoản phải thu</td><td></td><td>-980.08</td><td>836.29</td><td>-2,013.65</td><td>-1,040.27</td><td></td><td></td></tr><tr><td>Giảm/(tăng) hàng tồn kho</td><td></td><td>14.81</td><td>32.35</td><td>-16.10</td><td>-49.52</td><td></td><td></td></tr><tr><td>Tăng các khoản phải trả</td><td></td><td>12,084.57</td><td>1,706.00</td><td>-790.52</td><td>623.87</td><td></td><td></td></tr><tr><td>Tăng chi phí trả trước</td><td></td><td>-125.14</td><td>-267.66</td><td>-364.35</td><td>-328.90</td><td></td><td></td></tr><tr><td>(Tăng)/giảm chứng khoán kinh doanh</td><td></td><td>14.53</td><td>-422.76</td><td>-158.79</td><td>-171.57</td><td></td><td></td></tr><tr><td>Tiền lãi vay đã trả</td><td></td><td>-1,194.45</td><td>-1,536.70</td><td>-558.20</td><td>-1,138.75</td><td></td><td></td></tr><tr><td>Thuế thu nhập doanh nghiệp đã nộp</td><td></td><td>-435.25</td><td>-535.13</td><td>-292.80</td><td>-400.73</td><td></td><td></td></tr><tr><td>Tiền thu khác từ hoạt động kinh doanh</td><td></td><td>-</td><td>-</td><td>-</td><td>-</td><td></td><td></td></tr><tr><td>Tiền chi khác cho hoạt động kinh doanh</td><td></td><td>-82.62</td><td>-91.80</td><td>-81.67</td><td>-93.97</td><td></td><td></td></tr><tr><td>Lưu chuyển tiền thuần từ hoạt động kinh doanh</td><td></td><td>13,886.48</td><td>5,911.95</td><td>-2,697.96</td><td>-924.98</td><td></td><td></td></tr></tbody></table><table><thead><tr><th>Lưu chuyển tiền từ HĐ đầu tư</th><th></th><th>Q3-2025</th><th>Q4-2025</th><th>Q1-2026</th><th>Q2-2026</th><th></th></tr></thead><tbody><tr><td>Tiền chi để mua sắm, xây dựng tài sản cố định và các tài sản dài hạn khác</td><td></td><td>-86.69</td><td>-119.77</td><td>-43.83</td><td>-97.68</td><td></td><td></td></tr><tr><td>Tiền thu thanh lý, nhượng bán TSCĐ và các tài sản dài hạn khác</td><td></td><td>1.37</td><td>1.72</td><td>0.12</td><td>0.99</td><td></td><td></td></tr><tr><td>Tiền chi cho vay, mua các công cụ nợ của đơn vị khác/Tiền chi đầu tư vốn vào đơn vị khác</td><td></td><td>-129,091.60</td><td>-184,282.62</td><td>-61,198.77</td><td>-117,968.58</td><td></td><td></td></tr><tr><td>Tiền thu hổi cho vay, bán lại các công cụ nợ của đơn vị khác</td><td></td><td>114,145.77</td><td>150,198.59</td><td>46,862.89</td><td>95,809.14</td><td></td><td></td></tr><tr><td>Tiền chi đầu tư, góp vốn vào đơn vị khác</td><td></td><td>-108.81</td><td>-387.15</td><td>-154.79</td><td>-</td><td></td><td></td></tr><tr><td>Tiền thu hồi đầu tư, góp vốn vào đơn vị khác</td><td></td><td>102.56</td><td>102.56</td><td>-</td><td>29.64</td><td></td><td></td></tr><tr><td>Tiền lãi cho vay, cổ tức và lợi nhuận được chia</td><td></td><td>8,561.48</td><td>10,218.50</td><td>3,724.24</td><td>7,825.10</td><td></td><td></td></tr><tr><td>Lưu chuyển tiền thuần sử dụng vào hoạt động đầu tư</td><td></td><td>-6,475.91</td><td>-24,268.17</td><td>-10,810.14</td><td>-14,401.39</td><td></td><td></td></tr></tbody></table><table><thead><tr><th>Lưu chuyển tiền từ HĐ tài chính</th><th></th><th>Q3-2025</th><th>Q4-2025</th><th>Q1-2026</th><th>Q2-2026</th><th></th></tr></thead><tbody><tr><td>Tiển thu từ phát hành cổ phiếu, nhận vốn góp của chủ sở hữu</td><td></td><td>-</td><td>-</td><td>-</td><td>-</td><td></td><td></td></tr><tr><td>Tiền trả lại vốn góp cho các chủ sở hữu, mua lại cổ phiếu của doanh nghiệp đã phát hành</td><td></td><td>-</td><td>-</td><td>-</td><td>-</td><td></td><td></td></tr><tr><td>Tiền thu từ đi vay</td><td></td><td>54,182.70</td><td>95,733.11</td><td>44,171.14</td><td>76,044.53</td><td></td><td></td></tr><tr><td>Tiền chi trả nợ gốc vay</td><td></td><td>-57,756.07</td><td>-73,842.87</td><td>-32,257.86</td><td>-61,069.02</td><td></td><td></td></tr><tr><td>Tiền chi trả nợ thuê tài chính</td><td></td><td>-</td><td>-</td><td>-</td><td>-</td><td></td><td></td></tr><tr><td>Cổ tức, lợi nhuận đã trả cho chủ sở hữu</td><td></td><td>-1.50</td><td>-805.21</td><td>-</td><td>-</td><td></td><td></td></tr><tr><td>Lưu chuyển tiền thuần từ hoạt động tài chính</td><td></td><td>-3,574.87</td><td>21,085.03</td><td>11,913.28</td><td>14,975.51</td><td></td><td></td></tr><tr><td>Lưu chuyển tiền thuần trong kỳ (50= 20 + 30 + 40)</td><td></td><td>3,835.70</td><td>2,728.81</td><td>-1,594.82</td><td>-350.85</td><td></td><td></td></tr><tr><td>Tiền và tương đương tiền đầu kỳ</td><td></td><td>1,464.09</td><td>1,464.09</td><td>4,203.93</td><td>4,203.93</td><td></td><td></td></tr><tr><td>Ảnh hưởng của thay đổi tỷ giá hối đoái quy đổi ngoại tệ</td><td></td><td>1.87</td><td>1.72</td><td>-0.33</td><td>0.09</td><td></td><td></td></tr></tbody></table></body></html>